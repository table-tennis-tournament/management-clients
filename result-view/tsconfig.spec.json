{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/spec",
    "types": [
      "vitest/globals",
      "node"
    ],
    "typeRoots": [
      "node_modules/@types",
      "node_modules"
    ],
    "resolveJsonModule": true
  },
  "files": [
    "src/test-setup.ts",
    "src/polyfills.ts"
  ],
  "include": [
    "src/**/*.spec.ts",
    "src/**/*.d.ts",
    "vite.config.ts"
  ]
}
