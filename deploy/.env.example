# Copy to .env and fill in. .env is git-ignored: never commit it.

# --- database ---------------------------------------------------------------
# Name of the mktt database the tournament runs on: the name in the dump's
# `CREATE DATABASE` / `USE` lines (e.g. saturday_test).
TTT_DATABASE=tournament
# Root password, used only to load dumps and for maintenance.
MARIADB_ROOT_PASSWORD=change-me-root
# The backend's account; it gets all privileges on TTT_DATABASE only.
TTT_DB_USER=ttt
TTT_DB_PASSWORD=change-me-ttt

# Where the database port is published on the host. Keep 127.0.0.1 unless a
# machine in the hall must reach it (e.g. HeidiSQL on the mktt laptop).
DB_BIND_ADDRESS=127.0.0.1
DB_PORT=3306

# --- web --------------------------------------------------------------------
# The admin-view, tablemanager-view and result-view are served here.
HTTP_BIND_ADDRESS=0.0.0.0
HTTP_PORT=80

# --- printing ---------------------------------------------------------------
# Without a printer every job goes to the PDF printer (volume cups-output).
# For a network printer, e.g. CUPS_PRINTER_URI=ipp://192.168.1.50/ipp/print
CUPS_PRINTER_URI=
CUPS_PRINTER_NAME=
DEFAULT_PRINTER=PDF

# --- misc -------------------------------------------------------------------
TZ=Europe/Berlin
