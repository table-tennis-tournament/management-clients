@startuml
!include C4/C4_Component.puml

LAYOUT_WITH_LEGEND()

title Component diagram for the Backend (Spring Modulith modules)

Container_Boundary(backend, "Backend") {
    Component(registration, "registration", "Spring Modulith module", "Players, clubs, doubles, disciplines, registration state (paid, active); discipline colors")
    Component(tournament, "tournament", "Spring Modulith module", "Match lifecycle (TournamentMatch), Queue and auto-start, table assignment and locking, results, calls, table-manager and caller views")
    Component(grouping, "grouping", "Spring Modulith module", "Group standings when a group's last match is completed")
    Component(settings, "settings", "Spring Modulith module", "Settings, printers and print on assign; referee sheets as PDF (Flying Saucer) and QR codes")
    Component(outbound, "outbound", "Spring Modulith module", "The single publisher: turns domain events into update events on five STOMP topics")
    Component(broker, "STOMP endpoint", "Spring simple broker", "/ttt-websocket with /topic/matches, tables, queue, players, settings")
}

ContainerDb(mariadb, "Tournament Database", "MariaDB/MySQL", "mktt's schema plus the backend's mgmt_ sidecar tables (Flyway)")
System_Ext(cups, "CUPS", "Print server (lpr)")

Rel(tournament, grouping, "MatchCompleted", "domain event")
Rel(tournament, settings, "MatchAssigned", "domain event")
Rel(tournament, outbound, "Match, table and queue events", "domain events")
Rel(registration, outbound, "Player and discipline color events", "domain events")
Rel(outbound, broker, "Sends update events")

Rel(registration, mariadb, "Reads and writes", "JdbcClient")
Rel(tournament, mariadb, "Reads and writes", "JdbcClient")
Rel(grouping, mariadb, "Reads matches, writes standings", "JdbcClient")
Rel(settings, mariadb, "Reads matches for printing, writes settings", "JdbcClient")
Rel(settings, cups, "Prints referee sheets", "lpr")

SHOW_LEGEND()
@enduml
