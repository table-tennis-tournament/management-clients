@startuml
!include C4/C4_Dynamic.puml

title Dynamic diagram: enter a match result

Person(tableManager, "Table Manager")
Container(tableManagerView, "Table Manager View", "Angular 21")
Container(nginx, "Reverse Proxy", "Nginx")
Container(backend, "Backend", "Kotlin Spring Boot")
ContainerDb(mariadb, "Tournament Database", "MariaDB")
Container(resultView, "Result View", "Angular 21")

RelIndex(1, tableManager, tableManagerView, "Enters set and match results")
RelIndex(2, tableManagerView, nginx, "Sends the result", "HTTPS")
RelIndex(3, nginx, backend, "Proxies the request", "HTTP")
RelIndex(4, backend, mariadb, "Persists the result and marks the match completed", "JDBC")
RelIndex(5, backend, nginx, "Broadcasts the updated match and standings", "WebSocket")
RelIndex(6, nginx, resultView, "Pushes the update to all clients")

SHOW_LEGEND()
@enduml
